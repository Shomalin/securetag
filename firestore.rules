rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;                       // add admins by hand in the console
    }

    match /tags/{tagId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['itemName','ownerId','publicNote','status','batch','createdAt'])
        && request.resource.data.status == 'unclaimed'
        && request.resource.data.ownerId == null;
      allow delete: if false;
      // owner: activate or edit own tag, but never a disabled one
      allow update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == null)
        && resource.data.status != 'disabled'
        && request.resource.data.status in ['active','lost'];
      // admin: may only change status (disable / enable)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tagId','ownerId','text','contact','read','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && request.resource.data.read == false
        && get(/databases/$(db)/documents/tags/$(request.resource.data.tagId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(db)/documents/tags/$(request.resource.data.tagId)).data.status in ['active','lost'];
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
